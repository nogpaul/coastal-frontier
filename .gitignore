# Secrets — these would leak credentials if committed
.env
.env.local
*.key
secrets/

# Virtual environment — regenerated from requirements.txt
.venv/
venv/
env/

# Python build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.python-version

# Jupyter checkpoints
.ipynb_checkpoints/

# IDE / editor noise
.vscode/
.idea/
*.swp

# Caches
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data — regenerated by pipeline, not tracked
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Geospatial scratch
*.gpkg-journal
*.qgz~

# OS clutter
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
Untitled*.ipynb
